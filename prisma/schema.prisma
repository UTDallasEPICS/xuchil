// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum ProcessStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum DeliveryVariant {
  MAIL
  PERSONAL
  CONSIGNMENT
}

enum OrderStatus {
  SCHEDULED
  DELIVERED
  CANCELLED
}

enum ItemType {
  RAW
  PRODUCT
}

enum MovementDirection {
  IN
  OUT
}

enum MovementReason {
  PURCHASE
  CONSUMPTION_STEP
  ADJUSTMENT
  COMPLETION_RUN
  OUTBOUND_ORDER
}

model Unit {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  factorToBase Decimal @default("1")

  stepRequiredMaterials StepRequiredMaterial[]
  products              Product[]
  contentUnitVariants   ProductVariant[]       @relation("ContentUnitVariant")
  defaultUnitVariants   ProductVariant[]       @relation("DefaultUnitVariant")
  rawMaterials          RawMaterial[]
  plannedUnitRuns       ProcessRun[]           @relation("PlannedUnitRun")
  outputUnitRuns        ProcessRun[]           @relation("OutputUnitRun")
}

model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  products Product[]
}

model Product {
  id            Int     @id @default(autoincrement())
  categoryId    Int
  sku           String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  defaultUnit Unit?            @relation(fields: [defaultUnitId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId, name])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  name          String
  presentation  String?
  netContent    Decimal?
  contentUnitId Int?
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean  @default(true)

  product          Product           @relation(fields: [productId], references: [id])
  contentUnit      Unit?             @relation("ContentUnitVariant", fields: [contentUnitId], references: [id])
  defaultUnit      Unit?             @relation("DefaultUnitVariant", fields: [defaultUnitId], references: [id])
  processTemplates ProcessTemplate[]
  ProcessRun       ProcessRun[]

  @@unique([productId, name])
}

model RawMaterial {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  defaultUnit           Unit?                  @relation(fields: [defaultUnitId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  workers Worker[]
}

model Worker {
  id              Int     @id @default(autoincrement())
  fullName        String
  roleId          Int?
  phone           String?
  profilePhotoUrl String?
  isActive        Boolean @default(true)

  role       Role?        @relation(fields: [roleId], references: [id])
  authUsers  AuthUser[]
  ProcessRun ProcessRun[]
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  workerId     Int?
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  worker Worker? @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

model ProcessTemplate {
  id               Int     @id @default(autoincrement())
  productVariantId Int
  version          Int
  name             String
  isActive         Boolean @default(true)
  notes            String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  templateSteps  TemplateStep[]
  ProcessRun     ProcessRun[]

  @@unique([productVariantId, version])
}

model TemplateStep {
  id                Int     @id @default(autoincrement())
  processTemplateId Int
  position          Int
  name              String
  idealDurationMin  Int?
  requiresInput     Boolean @default(false)
  instructions      String?

  processTemplate       ProcessTemplate        @relation(fields: [processTemplateId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]

  @@unique([processTemplateId, position])
}

model StepRequiredMaterial {
  id               Int     @id @default(autoincrement())
  templateStepId   Int
  rawMaterialId    Int
  qtyPerUnitOutput Decimal
  unitId           Int

  templateStep TemplateStep @relation(fields: [templateStepId], references: [id])
  rawMaterial  RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
}

model ProcessRun {
  id                Int           @id @default(autoincrement())
  productVariantId  Int
  processTemplateId Int
  batchCode         String        @unique
  createdByWorkerId Int?
  plannedQty        Decimal?
  plannedUnitId     Int?
  status            ProcessStatus @default(PLANNED)
  startedAt         DateTime?
  finishedAt        DateTime?
  goodOutputQty     Decimal?
  scrapQty          Decimal?
  outputUnitId      Int?
  notes             String?

  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id])
  processTemplate ProcessTemplate @relation(fields: [processTemplateId], references: [id])
  creator         Worker?         @relation(fields: [createdByWorkerId], references: [id])
  plannedUnit     Unit?           @relation("PlannedUnitRun", fields: [plannedUnitId], references: [id])
  outputUnit      Unit?           @relation("OutputUnitRun", fields: [outputUnitId], references: [id])
  processPauses   ProcessPause[]

  @@index([productVariantId])
  @@index([processTemplateId])
  @@index([createdByWorkerId])
}

model ProcessPause {
  id           Int       @id @default(autoincrement())
  processRunId Int
  startedAt    DateTime
  endedAt      DateTime?
  reason       String?

  processRun ProcessRun @relation(fields: [processRunId], references: [id])

  @@index([processRunId])
}

model StepExecution {
  id                Int        @id @default(autoincrement())
  processRunId      Int
  templateStepId    Int
  workerId          Int?
  status            StepStatus @default(PENDING)
  startedAt         DateTime?
  finishedAt        DateTime?
  actualDurationMin Int?
  inputQty          Decimal?
  inputUnitId       Int?
  notes             String?

  processRun   ProcessRun   @relation(fields: [processRunId], references: [id])
  templateStep TemplateStep @relation(fields: [templateStepId], references: [id])
  worker       Worker?      @relation(fields: [workerId], references: [id])
  inputUnit    Unit?        @relation(fields: [inputUnitId], references: [id])
}

model StepMaterialUsage {
  id              Int     @id @default(autoincrement())
  stepExecutionId Int
  rawMaterialId   Int
  inventoryLotId  Int?
  qtyUsed         Decimal
  unitId          Int
  notes           String?

  stepExecution StepExecution @relation(fields: [stepExecutionId], references: [id])
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  inventoryLot  InventoryLot? @relation(fields: [inventoryLotId], references: [id])
  unit          Unit          @relation(fields: [unitId], references: [id])

  @@index([stepExecutionId])
}

model GuestCollaborator {
  id          Int     @id @default(autoincrement())
  displayName String
  contactInfo String?
  isActive    Boolean @default(true)
}

model StepParticipant {
  id              Int       @id @default(autoincrement())
  stepExecutionId Int
  workerId        Int?
  guestId         Int?
  roleInStep      String?
  startedAt       DateTime?
  finishedAt      DateTime?

  stepExecution StepExecution      @relation(fields: [stepExecutionId], references: [id])
  worker        Worker?            @relation(fields: [workerId], references: [id])
  guest         GuestCollaborator? @relation(fields: [guestId], references: [id])

  @@index([stepExecutionId, workerId])
  @@index([stepExecutionId, guestId])
}

model Order {
  id              Int            @id @default(autoincrement())
  client          String
  deliveryAddress String
  deliveryDate    DateTime
  deliveryMethod  DeliveryMethod
  deliveryStatus  DeliveryStatus @default(PENDING)
  productsOrdered OrderEntry[]
}

model OrderEntry {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model Inventory {
  id        Int     @id @default(autoincrement())
  quantity  Int
  threshold Int
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])
}

model InventoryMovement {
  id                  Int       @id @default(autoincrement())
  inventoryLotId      Int
  inventoryLot        InventoryLot @relation(fields: [inventoryLotId], references: [id])
  direction           MovementDirection
  qty                 Decimal   @db.Decimal(12, 4)
  unitId              Int
  unit                Unit      @relation(fields: [unitId], references: [id])
  reason              MovementReason
  relatedStepExecutionId Int?
  relatedProcessRunId   Int?
  relatedOrderId        Int?
  note                String?
  movedAt             DateTime
}

model InventoryLot {
  id             Int       @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lotCode        String    @db.VarChar(100)
  qtyOnHand      Decimal   @db.Decimal(12, 4)
  unitId         Int
  unit           Unit      @relation(fields: [unitId], references: [id])
  receivedAt     DateTime
  expiryAt       DateTime?
  movements      InventoryMovement[]
  stepUsages     StepMaterialUsage[]
}

model InventoryItem {
  id          Int       @id @default(autoincrement())
  itemType ItemType
  rawMaterialId Int?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  productVariantId Int?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  defaultUnitId Int
  defaultUnit   Unit       @relation(fields: [defaultUnitId], references: [id])
}
