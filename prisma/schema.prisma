// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum ProcessStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum DeliveryVariant {
  MAIL
  PERSONAL
  CONSIGNMENT
}

enum OrderStatus {
  SCHEDULED
  DELIVERED
  CANCELLED
}

enum ItemType {
  RAW
  PRODUCT
}

enum MovementReason {
  PURCHASE
  CONSUMPTION_STEP
  ADJUSTMENT
  COMPLETION_RUN
  OUTBOUND_ORDER
}

model Unit {
  id                        Int                        @id @default(autoincrement())
  name                      String                     @unique
  products                  Product[]
  rawMaterials              RawMaterial[]
  processStepMaterialUsages ProcessStepMaterialUsage[]
}

model ProductCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  imgUrl   String?
  products Product[]
}

model Product {
  id         Int     @id @default(autoincrement())
  categoryId Int
  name       String  @unique
  imgUrl     String?
  unitId     Int

  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  unit             Unit              @relation(fields: [unitId], references: [id])
  processTemplates ProcessTemplate[]
  inventoryItems   InventoryItem[]
  orderItems       OrderItem[]
}

model RawMaterial {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  unitId Int
  imgUrl String?

  unit                         Unit                          @relation(fields: [unitId], references: [id])
  processTemplateStepMaterials ProcessTemplateStepMaterial[]
  processStepMaterialUsages    ProcessStepMaterialUsage[]
  inventoryItems               InventoryItem[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String?             @unique
  phone              String?             @unique
  imgUrl             String?
  authInfos          AuthInfo[]
  processStepWorkers ProcessStepWorker[]
}

model AuthInfo {
  userId       Int     @id
  passwordHash String
  isAdmin      Boolean @default(false)
  isGuest      Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model ProcessTemplate {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String

  product              Product               @relation(fields: [productId], references: [id])
  processTemplateSteps ProcessTemplateStep[]
  processExecutions    ProcessExecution[]
}

model ProcessTemplateStep {
  id               Int     @id @default(autoincrement())
  processId        Int
  position         Int
  name             String
  idealDurationMin Int?
  instructions     String?

  process                      ProcessTemplate               @relation(fields: [processId], references: [id])
  processTemplateStepMaterials ProcessTemplateStepMaterial[]
  processStepExecutions        ProcessStepExecution[]

  @@unique([processId, position])
}

model ProcessTemplateStepMaterial {
  id            Int @id @default(autoincrement())
  stepId        Int
  rawMaterialId Int

  step        ProcessTemplateStep @relation(fields: [stepId], references: [id])
  rawMaterial RawMaterial         @relation(fields: [rawMaterialId], references: [id])
}

model ProcessExecution {
  id              Int           @id @default(autoincrement())
  processId       Int
  batchCode       String        @unique
  plannedQuantity Decimal?
  status          ProcessStatus @default(PLANNED)
  startedAt       DateTime
  finishedAt      DateTime?
  outputQuantity  Decimal?
  scrapQuantity   Decimal?
  notes           String?

  process               ProcessTemplate        @relation(fields: [processId], references: [id])
  processPauses         ProcessPause[]
  processStepExecutions ProcessStepExecution[]

  @@index([processId])
}

model ProcessPause {
  id                 Int       @id @default(autoincrement())
  processExecutionId Int
  startedAt          DateTime
  endedAt            DateTime?

  processExecution ProcessExecution @relation(fields: [processExecutionId], references: [id])

  @@index([processExecutionId])
}

model ProcessStepExecution {
  id                 Int        @id @default(autoincrement())
  processExecutionId Int
  stepId             Int
  status             StepStatus @default(PENDING)
  startedAt          DateTime?
  finishedAt         DateTime?
  actualDurationMin  Int?
  inputQty           Decimal?
  notes              String?

  processExecution          ProcessExecution           @relation(fields: [processExecutionId], references: [id])
  step                      ProcessTemplateStep        @relation(fields: [stepId], references: [id])
  inventoryMovements        InventoryMovement[]
  processStepMaterialUsages ProcessStepMaterialUsage[]
  processStepWorkers        ProcessStepWorker[]
}

model ProcessStepMaterialUsage {
  id              Int     @id @default(autoincrement())
  stepExecutionId Int
  rawMaterialId   Int
  qtyUsed         Decimal
  unitId          Int
  notes           String?

  stepExecution      ProcessStepExecution @relation(fields: [stepExecutionId], references: [id])
  rawMaterial        RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  unit               Unit                 @relation(fields: [unitId], references: [id])
  inventoryMovements InventoryMovement[]

  @@index([stepExecutionId])
}

model ProcessStepWorker {
  id              Int @id @default(autoincrement())
  stepExecutionId Int
  workerId        Int

  stepExecution ProcessStepExecution @relation(fields: [stepExecutionId], references: [id])
  worker        User                 @relation(fields: [workerId], references: [id])
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  itemType      ItemType
  rawMaterialId Int?
  productId     Int?
  quantity      Decimal

  rawMaterial        RawMaterial?        @relation(fields: [rawMaterialId], references: [id])
  product            Product?            @relation(fields: [productId], references: [id])
  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id                         Int            @id @default(autoincrement())
  itemId                     Int
  quantityChange             Decimal
  reason                     MovementReason
  relatedStepMaterialUsageId Int?
  relatedOrderId             Int?
  note                       String?
  movedAt                    DateTime

  item                     InventoryItem             @relation(fields: [itemId], references: [id])
  relatedstepMaterialUsage ProcessStepMaterialUsage? @relation(fields: [relatedStepMaterialUsageId], references: [id])
  relatedOrder             Order?                    @relation(fields: [relatedOrderId], references: [id])
  processStepExecution     ProcessStepExecution?     @relation(fields: [processStepExecutionId], references: [id])
  processStepExecutionId   Int?
}

model Order {
  id                 Int                 @id @default(autoincrement())
  clientName         String
  address            String?
  deliveryDate       DateTime
  deliveryVariant    DeliveryVariant     @default(MAIL)
  status             OrderStatus         @default(SCHEDULED)
  deliveredAt        DateTime?
  consignmentPartner String?
  notes              String?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([deliveryDate])
  @@index([status])
  @@index([deliveryVariant])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
