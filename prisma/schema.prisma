// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  workerId     Int?
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  worker Worker? @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  workers Worker[]
}

model Worker {
  id              Int     @id @default(autoincrement())
  fullName        String
  roleId          Int?
  phone           String?
  profilePhotoUrl String?
  isActive        Boolean @default(true)

  role      Role?      @relation(fields: [roleId], references: [id])
  authUsers AuthUser[]
}

model ProcessTemplate {
  id               Int     @id @default(autoincrement())
  productVariantId Int
  version          Int
  name             String
  isActive         Boolean @default(true)
  notes            String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  templateSteps  TemplateStep[]

  @@unique([productVariantId, version])
}

model TemplateStep {
  id                Int     @id @default(autoincrement())
  processTemplateId Int
  position          Int
  name              String
  idealDurationMin  Int?
  requiresInput     Boolean @default(false)
  instructions      String?

  processTemplate       ProcessTemplate        @relation(fields: [processTemplateId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]

  @@unique([processTemplateId, position])
}

model StepRequiredMaterial {
  id               Int     @id @default(autoincrement())
  templateStepId   Int
  rawMaterialId    Int
  qtyPerUnitOutput Decimal
  unitId           Int

  templateStep TemplateStep @relation(fields: [templateStepId], references: [id])
  rawMaterial  RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
}

model Unit {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  factorToBase Decimal @default("1")

  stepRequiredMaterials StepRequiredMaterial[]
  products              Product[]
  contentUnitVariants   ProductVariant[]       @relation("ContentUnitVariant")
  defaultUnitVariants   ProductVariant[]       @relation("DefaultUnitVariant")
  rawMaterials          RawMaterial[]
}

model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  products Product[]
}

model Product {
  id            Int     @id @default(autoincrement())
  categoryId    Int
  sku           String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  defaultUnit Unit?            @relation(fields: [defaultUnitId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId, name])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  name          String
  presentation  String?
  netContent    Decimal?
  contentUnitId Int?
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean  @default(true)

  product          Product           @relation(fields: [productId], references: [id])
  contentUnit      Unit?             @relation("ContentUnitVariant", fields: [contentUnitId], references: [id])
  defaultUnit      Unit?             @relation("DefaultUnitVariant", fields: [defaultUnitId], references: [id])
  processTemplates ProcessTemplate[]

  @@unique([productId, name])
}

model RawMaterial {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  defaultUnit           Unit?                  @relation(fields: [defaultUnitId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]
}
