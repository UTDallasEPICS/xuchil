// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProcessStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum DeliveryVariant {
  MAIL
  PERSONAL
  CONSIGNMENT
}

enum OrderStatus {
  SCHEDULED
  DELIVERED
  CANCELLED
}

enum ItemType {
  RAW
  PRODUCT
}

enum MovementDirection {
  IN
  OUT
}

enum MovementReason {
  PURCHASE
  CONSUMPTION_STEP
  ADJUSTMENT
  COMPLETION_RUN
  OUTBOUND_ORDER
}

model Unit {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  factorToBase Decimal @default("1")

  stepRequiredMaterials StepRequiredMaterial[]
  products              Product[]
  contentUnitVariants   ProductVariant[]       @relation("ContentUnitVariant")
  defaultUnitVariants   ProductVariant[]       @relation("DefaultUnitVariant")
  rawMaterials          RawMaterial[]
  plannedUnitRuns       ProcessRun[]           @relation("PlannedUnitRun")
  outputUnitRuns        ProcessRun[]           @relation("OutputUnitRun")
  stepExecutions        StepExecution[]
  stepMaterialUsages    StepMaterialUsage[]
  inventoryItems        InventoryItem[]
  inventoryLots         InventoryLot[]
  inventoryMovements    InventoryMovement[]
  orderItems            OrderItem[]
}

model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  products Product[]
}

model Product {
  id            Int     @id @default(autoincrement())
  categoryId    Int
  sku           String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  defaultUnit Unit?            @relation(fields: [defaultUnitId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId, name])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  name          String
  presentation  String?
  netContent    Decimal?
  contentUnitId Int?
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean  @default(true)

  product          Product           @relation(fields: [productId], references: [id])
  contentUnit      Unit?             @relation("ContentUnitVariant", fields: [contentUnitId], references: [id])
  defaultUnit      Unit?             @relation("DefaultUnitVariant", fields: [defaultUnitId], references: [id])
  processTemplates ProcessTemplate[]
  processRuns      ProcessRun[]
  inventoryItems   InventoryItem[]
  orderItems       OrderItem[]

  @@unique([productId, name])
}

model RawMaterial {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  name          String
  defaultUnitId Int?
  imageUrl      String?
  isActive      Boolean @default(true)

  defaultUnit           Unit?                  @relation(fields: [defaultUnitId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]
  stepMaterialUsages    StepMaterialUsage[]
  inventoryItems        InventoryItem[]
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  workers Worker[]
}

model Worker {
  id              Int     @id @default(autoincrement())
  fullName        String
  roleId          Int?
  phone           String?
  profilePhotoUrl String?
  isActive        Boolean @default(true)

  role             Role?             @relation(fields: [roleId], references: [id])
  authUsers        AuthUser[]
  processRuns      ProcessRun[]
  stepExecutions   StepExecution[]
  stepParticipants StepParticipant[]
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  workerId     Int?
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  worker Worker? @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

model ProcessTemplate {
  id               Int     @id @default(autoincrement())
  productVariantId Int
  version          Int
  name             String
  isActive         Boolean @default(true)
  notes            String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  templateSteps  TemplateStep[]
  processRuns    ProcessRun[]

  @@unique([productVariantId, version])
}

model TemplateStep {
  id                Int     @id @default(autoincrement())
  processTemplateId Int
  position          Int
  name              String
  idealDurationMin  Int?
  requiresInput     Boolean @default(false)
  instructions      String?

  processTemplate       ProcessTemplate        @relation(fields: [processTemplateId], references: [id])
  stepRequiredMaterials StepRequiredMaterial[]
  stepExecutions        StepExecution[]

  @@unique([processTemplateId, position])
}

model StepRequiredMaterial {
  id               Int     @id @default(autoincrement())
  templateStepId   Int
  rawMaterialId    Int
  qtyPerUnitOutput Decimal
  unitId           Int

  templateStep TemplateStep @relation(fields: [templateStepId], references: [id])
  rawMaterial  RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
}

model ProcessRun {
  id                Int           @id @default(autoincrement())
  productVariantId  Int
  processTemplateId Int
  batchCode         String        @unique
  createdByWorkerId Int?
  plannedQty        Decimal?
  plannedUnitId     Int?
  status            ProcessStatus @default(PLANNED)
  startedAt         DateTime?
  finishedAt        DateTime?
  goodOutputQty     Decimal?
  scrapQty          Decimal?
  outputUnitId      Int?
  notes             String?

  productVariant     ProductVariant      @relation(fields: [productVariantId], references: [id])
  processTemplate    ProcessTemplate     @relation(fields: [processTemplateId], references: [id])
  creator            Worker?             @relation(fields: [createdByWorkerId], references: [id])
  plannedUnit        Unit?               @relation("PlannedUnitRun", fields: [plannedUnitId], references: [id])
  outputUnit         Unit?               @relation("OutputUnitRun", fields: [outputUnitId], references: [id])
  processPauses      ProcessPause[]
  stepExecutions     StepExecution[]
  inventoryMovements InventoryMovement[]

  @@index([productVariantId])
  @@index([processTemplateId])
  @@index([createdByWorkerId])
}

model ProcessPause {
  id           Int       @id @default(autoincrement())
  processRunId Int
  startedAt    DateTime
  endedAt      DateTime?
  reason       String?

  processRun ProcessRun @relation(fields: [processRunId], references: [id])

  @@index([processRunId])
}

model StepExecution {
  id                Int        @id @default(autoincrement())
  processRunId      Int
  templateStepId    Int
  workerId          Int?
  status            StepStatus @default(PENDING)
  startedAt         DateTime?
  finishedAt        DateTime?
  actualDurationMin Int?
  inputQty          Decimal?
  inputUnitId       Int?
  notes             String?

  processRun         ProcessRun          @relation(fields: [processRunId], references: [id])
  templateStep       TemplateStep        @relation(fields: [templateStepId], references: [id])
  worker             Worker?             @relation(fields: [workerId], references: [id])
  inputUnit          Unit?               @relation(fields: [inputUnitId], references: [id])
  stepMaterialUsages StepMaterialUsage[]
  stepParticipants   StepParticipant[]
  inventoryMovements InventoryMovement[]
}

model StepMaterialUsage {
  id              Int     @id @default(autoincrement())
  stepExecutionId Int
  rawMaterialId   Int
  inventoryLotId  Int?
  qtyUsed         Decimal
  unitId          Int
  notes           String?

  stepExecution StepExecution @relation(fields: [stepExecutionId], references: [id])
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  inventoryLot  InventoryLot? @relation(fields: [inventoryLotId], references: [id])
  unit          Unit          @relation(fields: [unitId], references: [id])

  @@index([stepExecutionId])
}

model GuestCollaborator {
  id               Int               @id @default(autoincrement())
  displayName      String
  contactInfo      String?
  passwordHash     String?
  isActive         Boolean           @default(true)
  stepParticipants StepParticipant[]
}

model StepParticipant {
  id              Int       @id @default(autoincrement())
  stepExecutionId Int
  workerId        Int?
  guestId         Int?
  roleInStep      String?
  startedAt       DateTime?
  finishedAt      DateTime?

  stepExecution StepExecution      @relation(fields: [stepExecutionId], references: [id])
  worker        Worker?            @relation(fields: [workerId], references: [id])
  guest         GuestCollaborator? @relation(fields: [guestId], references: [id])

  @@index([stepExecutionId, workerId])
  @@index([stepExecutionId, guestId])
}

model InventoryItem {
  id               Int      @id @default(autoincrement())
  itemType         ItemType
  rawMaterialId    Int?
  productVariantId Int?
  defaultUnitId    Int?

  rawMaterial    RawMaterial?    @relation(fields: [rawMaterialId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  defaultUnit    Unit?           @relation(fields: [defaultUnitId], references: [id])
  inventoryLots  InventoryLot[]
}

model InventoryLot {
  id              Int       @id @default(autoincrement())
  inventoryItemId Int
  lotCode         String?
  qtyOnHand       Decimal?
  unitId          Int?
  receivedAt      DateTime
  expiryAt        DateTime?

  inventoryItem      InventoryItem?      @relation(fields: [inventoryItemId], references: [id])
  unit               Unit?               @relation(fields: [unitId], references: [id])
  stepMaterialUsages StepMaterialUsage[]
  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id                     Int               @id @default(autoincrement())
  inventoryLotId         Int
  direction              MovementDirection
  qty                    Decimal
  unitId                 Int
  reason                 MovementReason
  relatedStepExecutionId Int?
  relatedProcessRunId    Int?
  relatedOrderId         Int?
  note                   String?
  movedAt                DateTime

  inventoryLot         InventoryLot   @relation(fields: [inventoryLotId], references: [id])
  unit                 Unit           @relation(fields: [unitId], references: [id])
  relatedStepExecution StepExecution? @relation(fields: [relatedStepExecutionId], references: [id])
  relatedProcessRun    ProcessRun?    @relation(fields: [relatedProcessRunId], references: [id])
  relatedOrder         Order?         @relation(fields: [relatedOrderId], references: [id])
}

model Order {
  id                 Int                 @id @default(autoincrement())
  clientName         String
  addressText        String?
  deliveryDate       DateTime
  deliveryVariant    DeliveryVariant     @default(MAIL)
  status             OrderStatus         @default(SCHEDULED)
  deliveredAt        DateTime?
  consignmentPartner String?
  createdByUserId    Int?
  notes              String?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([deliveryDate])
  @@index([status])
  @@index([deliveryVariant])
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int
  productVariantId Int
  quantity         Decimal
  unitId           Int?
  notes            String?

  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  unit           Unit?          @relation(fields: [unitId], references: [id])
}
