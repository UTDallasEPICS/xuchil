// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  workerId     Int?
  worker       Worker?   @relation(fields: [workerId], references: [id])
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  @@index([workerId])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Worker {
  id              Int     @id @default(autoincrement())
  fullName        String
  roleId          Int?
  role            Role?   @relation(fields: [roleId], references: [id])
  phone           String?
  profilePhotoUrl String?
  isActive        Boolean @default(true)
}

model ProcessTemplate {
  id               Int     @id @default(autoincrement())
  productVariantId Int
  version          Int
  name             String
  isActive         Boolean @default(true)
  notes            String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([productVariantId, version])
}

model TemplateStep {
  id                Int             @id @default(autoincrement())
  processTemplateId Int
  processTemplate   ProcessTemplate @relation(fields: [processTemplateId], references: [id])
  position          Int
  name              String
  idealDurationMin  Int?
  requiresInput     Boolean         @default(false)
  instructions      String?

  @@unique([processTemplateId, position])
}

model StepRequiredMaterial {
  id               Int          @id @default(autoincrement())
  templateStepId   Int
  templateStep     TemplateStep @relation(fields: [templateStepId], references: [id])
  rawMaterialId    Int
  rawMaterial      RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  qtyPerUnitOutput Decimal
  unitId           Int
}

model Unit {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  factor_to_base  Decimal?         @default("1")

  products_default    Product[]        @relation("ProductDefaultUnit")
  variants_default    ProductVariant[] @relation("ProductVariantDefaultUnit")
  variants_content    ProductVariant[] @relation("ProductVariantContentUnit")
  raw_materials       RawMaterial[]
}

//Product categories
model ProductCategory {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  image_url  String?
  is_active  Boolean  @default(true)

  products   Product[]
}

//Product families
model Product {
  id               Int      @id @default(autoincrement())
  category_id      Int
  sku              String   @unique
  name             String
  default_unit_id  Int?
  image_url        String?
  is_active        Boolean  @default(true)

  category    ProductCategory @relation(fields: [category_id], references: [id])
  defaultUnit Unit?           @relation("ProductDefaultUnit", fields: [default_unit_id], references: [id])

  variants    ProductVariant[]

  @@index([category_id, name], map: "idx_product_category_name")
}

//Specific sellable variants
model ProductVariant {
  id                Int      @id @default(autoincrement())
  product_id        Int
  name              String
  presentation      String?
  net_content       Decimal?
  content_unit_id   Int?
  default_unit_id   Int?
  image_url         String?
  is_active         Boolean  @default(true)


  product      Product @relation(fields: [product_id], references: [id])
  contentUnit  Unit?   @relation("ProductVariantContentUnit", fields: [content_unit_id], references: [id])
  defaultUnit  Unit?   @relation("ProductVariantDefaultUnit", fields: [default_unit_id], references: [id])


  @@unique([product_id, name])
}

// Raw materials (inputs)
model RawMaterial {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String
  default_unit_id  Int?
  image_url        String?
  is_active        Boolean  @default(true)


  defaultUnit Unit? @relation(fields: [default_unit_id], references: [id])
}