// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AuthUser {
  id           Int       @id @default(autoincrement())
  workerId     Int?
  worker       Worker?   @relation(fields: [workerId], references: [id])
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  @@index([workerId])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Worker {
  id              Int     @id @default(autoincrement())
  fullName        String
  roleId          Int?
  role            Role?   @relation(fields: [roleId], references: [id])
  phone           String?
  profilePhotoUrl String?
  isActive        Boolean @default(true)
}

model ProcessTemplate {
  id               Int     @id @default(autoincrement())
  productVariantId Int
  version          Int
  name             String
  isActive         Boolean @default(true)
  notes            String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([productVariantId, version])
}

model TemplateStep {
  id                Int             @id @default(autoincrement())
  processTemplateId Int
  processTemplate   ProcessTemplate @relation(fields: [processTemplateId], references: [id])
  position          Int
  name              String
  idealDurationMin  Int?
  requiresInput     Boolean         @default(false)
  instructions      String?

  @@unique([processTemplateId, position])
}

model StepRequiredMaterial {
  id               Int          @id @default(autoincrement())
  templateStepId   Int
  templateStep     TemplateStep @relation(fields: [templateStepId], references: [id])
  rawMaterialId    Int
  rawMaterial      RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  qtyPerUnitOutput Decimal
  unitId           Int
}
