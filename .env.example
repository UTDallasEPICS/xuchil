# Required in every environment.
SESSION_SECRET=replace-with-a-long-random-secret

# SQLite by default. On ephemeral hosts, point to a persistent path or volume.
DATABASE_URL="file:./dev.db"

# Optional. Comma-separated allowlist for cross-origin browser clients.
# Leave unset when the UI and /api share the same origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
